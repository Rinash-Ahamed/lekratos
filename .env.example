# ───────────────────────── le.kratos — environment ─────────────────────────
# Copy to .env.local for development. In production set these in your host's secret manager.
# NEVER commit real values.

# Public site URL (canonical links, sitemap, Open Graph, CSRF origin check). REQUIRED in production.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Data backend ──
# "firestore" in production. "json" stores data in ./.data (development / single-instance trial only).
DATA_BACKEND=json
# Production refuses the JSON store unless you explicitly set this (not recommended).
# ALLOW_JSON_IN_PRODUCTION=1

# ── Firebase Admin (server only — never exposed to the browser) ──
# Option A: whole service-account JSON on one line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Option B: individual fields (keep the \n escapes in the private key)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Cloud Storage bucket for product images + private enquiry attachments
# FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ── Razorpay ──
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → https://YOUR-SITE/api/razorpay/webhook
# Events: payment.captured, order.paid, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# ── Admin ──
# Generate with:  npm run admin:hash   (scrypt; plaintext ADMIN_PASSWORD is ignored in production)
ADMIN_PASSWORD_HASH=
# 32+ random characters:  openssl rand -base64 48
ADMIN_SESSION_SECRET=
# Development convenience only (ignored when NODE_ENV=production)
# ADMIN_PASSWORD=

# ── Stock-hold housekeeping ──
# Call GET /api/cron/sweep every ~5 min with "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
# Minutes unpaid checkouts hold stock (5–120, default 20)
# RESERVATION_MINUTES=20

# ── Security headers ──
# Set to "report-only" while testing a new CSP, then remove.
# CSP_MODE=report-only

# Number of trusted reverse-proxy hops in front of the app (used for rate-limit IPs). Default 1.
TRUST_PROXY_HOPS=1
